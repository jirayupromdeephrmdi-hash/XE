local ESPObjects = {}

local function IsVisible(char)
    local origin = Camera.CFrame.Position
    local targetPos = char.HumanoidRootPart.Position
    local dir = targetPos - origin
    local ray = Ray.new(origin, dir.Unit * dir.Magnitude)
    local hit = workspace:FindPartOnRayWithIgnoreList(ray, {LocalPlayer.Character, char})
    return hit == nil
end

local function CreateESP(player)
    if player == LocalPlayer then return end
    local box = Drawing.new("Square"); box.Thickness=1.5; box.Filled=false; box.Visible=false
    local hBar = Drawing.new("Line"); hBar.Thickness=3; hBar.Visible=false
    local hBg = Drawing.new("Line"); hBg.Thickness=3; hBg.Color=Color3.fromRGB(0,0,0); hBg.Visible=false
    local nTag = Drawing.new("Text"); nTag.Size=14; nTag.Center=true; nTag.Outline=true; nTag.Color=Color3.fromRGB(255,255,255); nTag.Visible=false
    local dTag = Drawing.new("Text"); dTag.Size=12; dTag.Center=true; dTag.Outline=true; dTag.Color=Color3.fromRGB(255,255,0); dTag.Visible=false
    ESPObjects[player] = {Box=box, Health=hBar, HealthBg=hBg, Name=nTag, Distance=dTag}
end

Players.PlayerRemoving:Connect(function(p)
    if ESPObjects[p] then
        for _, o in pairs(ESPObjects[p]) do pcall(function() o:Remove() end) end
        ESPObjects[p] = nil
    end
end)

local function UpdateESP()
    if not Config.ESP.Enabled then
        for _, objs in pairs(ESPObjects) do for _, o in pairs(objs) do o.Visible = false end end
        return
    end
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") or not player.Character:FindFirstChild("Humanoid") then
                if ESPObjects[player] then for _, o in pairs(ESPObjects[player]) do o.Visible = false end end
                continue
            end
            if Config.ESP.TeamCheck and player.Team == LocalPlayer.Team then
                if ESPObjects[player] then for _, o in pairs(ESPObjects[player]) do o.Visible = false end end
                continue
            end
            if not ESPObjects[player] then CreateESP(player) end
            local objs = ESPObjects[player]
            local char = player.Character
            local root = char.HumanoidRootPart
            local hum = char.Humanoid

            if hum.Health <= 0 then
                for _, o in pairs(objs) do o.Visible = false end
                continue
            end

            local dist = (root.Position - Camera.CFrame.Position).Magnitude
            if dist > Config.ESP.MaxDistance then
                for _, o in pairs(objs) do o.Visible = false end
                continue
            end
            if Config.ESP.WallCheck and not IsVisible(char) then
                for _, o in pairs(objs) do o.Visible = false end
                continue
            end

            local sp, onScreen = Camera:WorldToViewportPoint(root.Position)
            if not onScreen then
                for _, o in pairs(objs) do o.Visible = false end
                continue
            end

            local hp = Camera:WorldToViewportPoint(char.Head.Position)
            local h = math.abs(hp.Y - sp.Y) * 1.6
            local w = h * 0.55

            local color = Config.ESP.Color
            if Config.ESP.Rainbow then color = Color3.fromHSV((tick()*0.5)%1, 1, 1) end

            if Config.ESP.Box then
                objs.Box.Size = Vector2.new(w, h)
                objs.Box.Position = Vector2.new(sp.X - w/2, sp.Y - h/2)
                objs.Box.Color = color
                objs.Box.Visible = true
            else objs.Box.Visible = false end

            if Config.ESP.Health then
                local pct = hum.Health / hum.MaxHealth
                local bx = sp.X - w/2 - 6
                objs.HealthBg.From = Vector2.new(bx, sp.Y - h/2)
                objs.HealthBg.To = Vector2.new(bx, sp.Y + h/2)
                objs.HealthBg.Visible = true
                objs.Health.From = Vector2.new(bx, sp.Y + h/2 - (h*pct))
                objs.Health.To = Vector2.new(bx, sp.Y + h/2)
                objs.Health.Color = Color3.fromRGB(math.floor(255*(1-pct)), math.floor(255*pct), 0)
                objs.Health.Visible = true
            else objs.Health.Visible = false; objs.HealthBg.Visible = false end

            if Config.ESP.Name then
                objs.Name.Text = player.Name
                objs.Name.Position = Vector2.new(sp.X, sp.Y - h/2 - 18)
                objs.Name.Color = color
                objs.Name.Visible = true
            else objs.Name.Visible = false end

            if Config.ESP.Distance then
                objs.Distance.Text = string.format("[%d]", math.floor(dist))
                objs.Distance.Position = Vector2.new(sp.X, sp.Y + h/2 + 4)
                objs.Distance.Visible = true
            else objs.Distance.Visible = false end
        end
    end
end

-- ==========================================
-- [5] Aim + Target Line (เฉพาะถือปืน)
-- ==========================================
local currentTarget = nil

local function IsHoldingWeapon()
    local char = LocalPlayer.Character
    if not char then return false end
    return char:FindFirstChildOfClass("Tool") ~= nil
end

local function GetTargetInFOV()
    local closest, shortest = nil, Config.Aim.FOVRadius
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then continue end
        local hum = player.Character:FindFirstChild("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        if Config.Aim.TeamCheck and player.Team == LocalPlayer.Team then continue end

        local root = player.Character.HumanoidRootPart
        local dist = (root.Position - Camera.CFrame.Position).Magnitude
        if dist > Config.Aim.MaxDistance then continue end
        if Config.Aim.WallCheck and not IsVisible(player.Character) then continue end

        local sp, onScreen = Camera:WorldToViewportPoint(root.Position)
        if not onScreen then continue end

        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
        if d < shortest then closest = player; shortest = d end
    end
    return closest
end

local function UpdateAim()
    if not Config.Aim.Enabled or not IsHoldingWeapon() then
        TargetLine.Visible = false
        currentTarget = nil
        return
    end
    local target = GetTargetInFOV()
    currentTarget = target
    if target then
        local sp, onScreen = Camera:WorldToViewportPoint(target.Character.HumanoidRootPart.Position)
        if Config.Aim.ShowTargetLine and onScreen then
            TargetLine.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
            TargetLine.To = Vector2.new(sp.X, sp.Y)
            TargetLine.Visible = true
        else TargetLine.Visible = false end
    else TargetLine.Visible = false end
end

-- ==========================================
-- [6] Infinite Ammo + Stamina
-- ==========================================
local function ApplyInfiniteAmmo()
    local char = LocalPlayer.Character
    if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        for _, obj in pairs(tool:GetDescendants()) do
            if obj:IsA("IntValue") or obj:IsA("NumberValue") then
                local n = obj.Name:lower()
                if n:find("ammo") or n:find("clip") or n:find("mag") or n:find("bullet") then
                    pcall(function() obj.Value = 999 end)
                end
            end
        end
    end
end

local function ApplyInfiniteStamina()
    local char = LocalPlayer.Character
    if not char then return end
    for _, obj in pairs(char:GetDescendants()) do
        if obj:IsA("IntValue") or obj:IsA("NumberValue") then
            local n = obj.Name:lower()
            if n:find("stamina") or n:find("energy") or n:find("stam") then
                pcall(function() obj.Value = obj.Value + 100 end)
            end
        end
    end
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if pg then
        for _, obj in pairs(pg:GetDescendants()) do
            if obj:IsA("IntValue") or obj:IsA("NumberValue") then
                local n = obj.Name:lower()
                if n:find("stamina") or n:find("energy") or n:find("stam") then
                    pcall(function() obj.Value = obj.Value + 100 end)
                end
            end
        end
    end
end

